# Caddy in front of the controller on LXC 108.
#
# The cert paths below are the ones on the controller. Replace them if yours differ; everything
# else should work as-is.

pve-agents.puff.lan {
	tls /etc/caddy/certs/pve-agents.puff.lan.crt /etc/caddy/certs/pve-agents.puff.lan.key

	# flush_interval -1 disables response buffering. Without it Caddy holds the agent event
	# stream in a buffer, and the detail page updates in bursts or not at all. This fails only
	# behind the proxy, never against the port directly, which is what makes it worth stating.
	# The controller binds CONTROLLER_HOST, not loopback, so this is its LAN address rather
	# than 127.0.0.1. Pointing Caddy at loopback gets a connection refused.
	reverse_proxy 10.0.3.50:3000 {
		flush_interval -1
	}

	# Compression buffers too, so the stream path is excluded and everything else still gets
	# gzip. A response matcher cannot express this: `encode` rejects `not` there, so the
	# exclusion is a named request matcher on the path instead.
	@compressible not path /api/workspaces/*/stream /api/workspaces/*/agent
	encode @compressible gzip

	# The controller holds a Proxmox token that can purge containers. Keep the access log.
	log {
		output file /var/log/caddy/pve-agents.log
	}
}

# Anything arriving on plain HTTP goes to TLS rather than being served twice.
http://pve-agents.puff.lan {
	redir https://{host}{uri} permanent
}
