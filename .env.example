# Persistent controller state. The parent directory must exist and be writable.
DATABASE_PATH=./data/controller.db

# The Node listener defaults to loopback. Use a trusted LAN address only when required.
CONTROLLER_HOST=127.0.0.1
CONTROLLER_PORT=3000

# Keep false until a Proxmox executor adapter exists and the configuration below is verified.
PROVISIONING_ENABLED=false

# Required before provisioning can be enabled.
PROXMOX_URL=https://pve.example.internal:8006/api2/json
PROXMOX_TOKEN_ID=workspace-controller@pve!controller
PROXMOX_TOKEN_SECRET=replace-me
PROXMOX_NODE=pve1
PROXMOX_TEMPLATE_VMID=9000
PROXMOX_POOL=disposable-workspaces
PROXMOX_BRIDGE=vmbr0

# Configure these before SSH bootstrap is enabled.
WORKSPACE_SSH_USER=agent
WORKSPACE_SSH_KEY_PATH=/var/lib/pve-herdr-agents/ssh/controller
WORKSPACE_HERDR_SESSION=agents
