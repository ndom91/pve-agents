# Copy to .env for local development. Every pnpm entrypoint loads it with Node's
# --env-file-if-exists, so a missing .env is fine and real values never need to be exported by
# hand. .env is gitignored; keep real secrets out of this file.
#
# In production the same variables come from /opt/pve-agents/.env through the systemd
# EnvironmentFile, not from a .env in this checkout.

# Persistent controller state. The parent directory must exist and be writable.
DATABASE_PATH=./data/controller.db
CONTROLLER_ID=replace-with-a-stable-deployment-uuid

# The Node listener defaults to loopback. Use a trusted LAN address only when required.
CONTROLLER_HOST=127.0.0.1
CONTROLLER_PORT=3000

# Must exactly match the origin the browser uses. better-auth derives cookie and CSRF behaviour
# from this, so a mismatch produces sign-ins that appear to succeed and then have no session.
CONTROLLER_URL=http://127.0.0.1:3000

# Signs sessions and API keys. At least 32 characters; generate with:
#   head -c 48 /dev/urandom | base64 | tr -d '\n='
CONTROLLER_AUTH_SECRET=replace-me

# GitHub OAuth app with callback <CONTROLLER_URL>/api/auth/callback/github and scope user:email.
# CONTROLLER_OPERATOR_GITHUB_ID is the only account that may ever sign in. Use the numeric account
# id, not the login: a login can be released and claimed by someone else. Find it with
#   curl -s https://api.github.com/users/<login> | jq .id
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
CONTROLLER_OPERATOR_GITHUB_ID=replace-me

# Keep false until the Proxmox configuration below is verified against disposable infrastructure.
# Enabling it also requires the auth and GitHub settings above.
PROVISIONING_ENABLED=false

# Required before provisioning can be enabled.
PROXMOX_URL=https://pve.example.internal:8006/api2/json
PROXMOX_TOKEN_ID=workspace-controller@pve!controller
PROXMOX_TOKEN_SECRET=replace-me
PROXMOX_NODE=pve1
PROXMOX_TEMPLATE_VMID=9000
PROXMOX_POOL=disposable-workspaces
PROXMOX_BRIDGE=vmbr0

# Runs the operation worker inside the server process. Off by default so the first real clone and
# destroy are stepped by hand with `pnpm worker:tick`.
WORKER_ENABLED=false
WORKER_INTERVAL_SECONDS=5

# Configure these before SSH bootstrap is enabled.
WORKSPACE_SSH_USER=agent
WORKSPACE_SSH_KEY_PATH=/var/lib/pve-agents/ssh/controller
