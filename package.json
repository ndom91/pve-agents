{
	"name": "pve-herdr-agents",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev --port 3000",
		"start": "node --env-file-if-exists=.env bin/controller-server.mjs",
		"generate-routes": "tsr generate",
		"build": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js build && node --env-file-if-exists=.env node_modules/vite/bin/vite.js build --config vite.cli.config.ts",
		"preview": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js preview",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"build:cli": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js build --config vite.cli.config.ts",
		"worker:tick": "node --env-file-if-exists=.env dist/cli/worker.js",
		"apikey:create": "node --env-file-if-exists=.env dist/cli/apikey.js"
	},
	"dependencies": {
		"@better-auth/api-key": "^1.7.4",
		"@tanstack/react-router": "latest",
		"@tanstack/react-start": "latest",
		"better-auth": "^1.7.4",
		"better-sqlite3": "^13.0.3",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@tanstack/router-cli": "^1.167.36",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vitest": "^5.0.0"
	},
	"engines": {
		"node": ">=22"
	}
}
